{
  "name": "@resolve/api",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "dev": "tsc-watch --onSuccess 'node dist/main.js'",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:integration": "npm run build && node --test test/integration.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/typeorm": "12.0.2",
    "@resolve/contracts": "0.2.0",
    "@slack/logger": "^5.0.0",
    "@slack/socket-mode": "^3.1.1",
    "dotenv": "^17.2.3",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "1.1.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsc-watch": "^7.2.0",
    "vitest": "^3.2.4"
  }
}
