---
import type { AppState } from '@resolve/contracts';
import { COPY } from '../consts/copy';
import { ROUTES } from '../consts/routes';
import ActionForm from './ActionForm.astro';
import PageHeading from './PageHeading.astro';
interface Props {
  connections: AppState['connections'];
  slack: AppState['slack'];
}
const { connections, slack } = Astro.props;
const text = COPY.connections;
---

<PageHeading
  eyebrow={text.eyebrow}
  title={text.title}
  description={text.description}
  badge={text.serverKeys}
/>
<div class="connections-grid">
  <section class="panel settings-card">
    <div class="provider-heading">
      <div><h2>{text.mistral}</h2><p>{text.mistralDescription}</p></div><span class="badge"
        >{connections.mistral ? text.configured : text.notConnected}</span
      >
    </div><p class="inline-note">{text.keyGuidance}</p><ActionForm
      action="connect"
      view="connections"
      ><input type="hidden" name="provider" value="mistral" /><label
        >{text.mistralKey}<input
          type="password"
          name="key"
          required
          minlength="10"
          maxlength="1000"
          autocomplete="off"
          spellcheck="false"
          placeholder={COPY.placeholders.key}
        /></label
      ><button class="button-primary" type="submit">{text.connect}</button></ActionForm
    ><ActionForm action="test-mistral" view="connections" class="standalone-form"
      ><button class="button-secondary" type="submit">{text.test}</button></ActionForm
    ><p class="field-note">{text.memoryNote}</p><a
      class="text-link"
      href={ROUTES.mistralConsole}
      target="_blank"
      rel="noreferrer">{text.console}</a
    >
  </section>
  <section class="panel settings-card">
    <div class="provider-heading">
      <div><h2>{text.jev}</h2><p>{text.jevDescription}</p></div><span class="badge"
        >{connections.jev ? text.configured : text.optional}</span
      >
    </div><p class="body-copy">{text.jevBody}</p><ActionForm action="connect" view="connections"
      ><input type="hidden" name="provider" value="jev" /><label
        >{text.jevKey}<input
          type="password"
          name="key"
          required
          minlength="10"
          maxlength="1000"
          autocomplete="off"
          spellcheck="false"
          placeholder={COPY.placeholders.optionalKey}
        /></label
      ><button class="button-secondary" type="submit">{text.connectJev}</button></ActionForm
    ><p class="field-note">{text.jevNote}</p>
  </section>
  <section class="panel settings-card">
    <div class="provider-heading">
      <div><h2>{text.billing}</h2><p>{text.billingDescription}</p></div><span class="badge"
        >{text.testOnly}</span
      >
    </div><p class="body-copy">{text.billingBody}</p><p class="field-note">{text.billingNote}</p>
  </section>
  <section class="panel settings-card">
    <div class="provider-heading">
      <h2>{COPY.product.slackTitle}</h2><span class="badge"
        >{
          slack.connected
            ? COPY.experience.connected
            : slack.lastError
              ? COPY.experience.connectionIssue
              : COPY.experience.notConnected
        }</span
      >
    </div><p class="body-copy">{COPY.product.slackBody}</p><p class="field-note">
      {COPY.product.slackSetup}
    </p><ActionForm action="connect-slack" view="connections"
      >{
        text.slackFields.map((field) => (
          <label>
            {field.label}
            <input
              type={field.secret ? 'password' : 'text'}
              name={field.name}
              maxlength="2000"
              autocomplete="off"
            />
          </label>
        ))
      }<p class="field-note">{text.slackDisconnect}</p><button class="button-secondary"
        >{text.slackSave}</button
      ></ActionForm
    ><p class="field-note"></p>
  </section>
</div>
