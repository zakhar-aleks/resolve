---
import type { WorkspaceModel } from '../types/workspace';
import { COPY } from '../consts/copy';
import Sidebar from './Sidebar.astro';
import SupportInbox from './SupportInbox.astro';
import CompanySettings from './CompanySettings.astro';
import ActionCenter from './ActionCenter.astro';
import PrivacyCenter from './PrivacyCenter.astro';
import Connections from './Connections.astro';
interface Props {
  model: WorkspaceModel;
}
const { model } = Astro.props;
---

<Sidebar companyName={model.state.company.companyName} view={model.view} />
<div class="workspace-shell">
  <header class="topbar">
    <div class="breadcrumb">
      <span>{model.state.company.companyName}</span><span>{COPY.symbols.slash}</span><b
        >{COPY.nav[model.view]}</b
      >
    </div><span class="header-status"
      >{COPY.shell.headerStatus}<span class="avatar">{COPY.shell.operator}</span></span
    >
  </header>
  <main>
    {
      model.notice && (
        <div
          class:list={['notice', { 'is-error': model.notice.kind === 'error' }]}
          role={model.notice.kind === 'error' ? 'alert' : 'status'}
        >
          {model.notice.message}
        </div>
      )
    }{
      model.view === 'support' ? (
        <SupportInbox model={model} />
      ) : model.view === 'workflows' ? (
        <ActionCenter state={model.state} />
      ) : model.view === 'company' ? (
        <CompanySettings company={model.state.company} prompt={model.state.promptPreview} />
      ) : model.view === 'privacy' ? (
        <PrivacyCenter profile={model.state.privacy} />
      ) : (
        <Connections connections={model.state.connections} slack={model.state.slack} />
      )
    }<footer>
      <span>{COPY.shell.footer}</span><a href="/privacy-policy">{COPY.product.notice}</a><a
        href="/terms">{COPY.product.terms}</a
      >
    </footer>
  </main>
</div>
