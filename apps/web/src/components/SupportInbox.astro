---
import { COPY } from '../consts/copy';
import { fragmentUrl, workspaceUrl } from '../helpers/routes';
import { formatTime, initials } from '../utils/format';
import { supportMetrics } from '../services/support-view';
import type { WorkspaceModel } from '../types/workspace';
import PageHeading from './PageHeading.astro';
import Conversation from './Conversation.astro';
import CaseDialog from './CaseDialog.astro';
interface Props {
  model: WorkspaceModel;
}
const { model } = Astro.props;
const { state, record } = model;
const text = COPY.experience;
const metrics = supportMetrics(state);
---

<PageHeading eyebrow={text.eyebrow} title={text.title} description={text.description}
  ><button data-open-dialog type="button" class="button-secondary">{text.newRequest}</button
  ></PageHeading
>
<div class="care-promises">
  <span><span>{COPY.symbols.pass}</span>{text.arrival}</span><span
    ><span>{COPY.symbols.pass}</span>{text.humanControl}</span
  ><a href="/?view=privacy">{text.privacyLink}{COPY.productMark}</a>
</div>
<div
  data-triage-refresh
  hx-get={fragmentUrl('support', record?.id)}
  hx-trigger="every 8s"
  hx-target="#workspace"
  hx-swap="innerHTML"
>
</div>
<div class="metrics">
  {
    metrics.map((metric) => (
      <div>
        <>
          <span>{metric.label}</span>
          <strong>{metric.value}</strong>
          <small>{metric.detail}</small>
        </>
      </div>
    ))
  }
</div>
<div class="work-grid">
  <section class="panel inbox">
    <div class="panel-heading">
      <h2>{text.allRequests}</h2><span class="badge">{state.cases.length}</span>
    </div><div class="case-list">
      {
        state.cases.map((item) => (
          <a
            class:list={['case-link', { 'is-active': item.id === record?.id }]}
            href={workspaceUrl('support', item.id)}
            hx-get={fragmentUrl('support', item.id)}
            hx-target="#workspace"
            hx-swap="innerHTML"
            hx-push-url={workspaceUrl('support', item.id)}
          >
            <>
              <div class="case-top">
                <>
                  <span class="avatar">{initials(item.name)}</span>
                  <b>{item.name}</b>
                  <span
                    class:list={[
                      'case-indicator',
                      { 'needs-attention': item.triageStatus === 'review' },
                    ]}
                  />
                </>
              </div>
              <h3>{item.title}</h3>
              <p>{item.summary || text.preparing}</p>
              <div class="case-tags">
                {item.tags.slice(0, 2).map((tag) => (
                  <span>{tag}</span>
                ))}
              </div>
              <small>{item.assignee || text.unassigned}</small>
            </>
          </a>
        ))
      }
    </div>
  </section>{record && <Conversation model={model} record={record} />}
</div>
<details class="team-activity">
  <summary>{text.activity}</summary><section class="panel ledger">
    <div class="panel-heading">
      <h2>{text.activity}</h2><span class="subtle">{text.activityDetail}</span>
    </div><div class="events">
      {
        state.events.length ? (
          state.events.map((event) => (
            <div class="event">
              <>
                <span class="event-state">{COPY.states[event.state]}</span>
                <p>{COPY.events[event.code]}</p>
                <time datetime={event.createdAt}>{formatTime(event.createdAt)}</time>
              </>
            </div>
          ))
        ) : (
          <p class="subtle">{COPY.support.ledgerEmpty}</p>
        )
      }
    </div>
  </section>
</details><CaseDialog />
