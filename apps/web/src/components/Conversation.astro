---
import { copyText } from '../helpers/copy';
import type { SupportCase } from '@resolve/contracts';
import type { WorkspaceModel } from '../types/workspace';
import { COPY } from '../consts/copy';
import { formatMoney, initials } from '../utils/format';
import { supportPresentation } from '../services/support-view';
import ActionForm from './ActionForm.astro';
import AgentResult from './AgentResult.astro';
interface Props {
  model: WorkspaceModel;
  record: SupportCase;
}
const { model, record } = Astro.props;
const { state, run, operation } = model;
const text = COPY.support;
const view = supportPresentation(model);
---

<section class="panel conversation">
  <div class="panel-heading">
    <div><h2>{record.title}</h2><p class="subtle">{record.customerId}</p></div>
    <span class="badge">{text.billing}</span>
  </div>
  <div class="conversation-body">
    <div class="customer-label">
      <span class="avatar">{initials(record.name)}</span>
      <div><b>{record.name}</b><small>{text.customerRequest}</small></div>
    </div>
    <ActionForm action="analyze" caseId={record.id}>
      <label class="sr-only" for="customer-message">{text.message}</label>
      <textarea id="customer-message" name="message" maxlength="4000" required
        >{run?.message ?? record.message}</textarea
      >
      <div class="payment">
        <b>{record.provider === 'stripe' ? text.stripePayment : text.simulatedPayment}</b>
        <b>{formatMoney(record.amountCents)}</b>
        <code>{record.paymentId}</code>
        <span>{copyText.age(record.ageDays)}</span>
        <span>{text.refundedLabel}{COPY.separators.colon} {formatMoney(record.refundedCents)}</span>
        <span>{COPY.states[record.subscriptionStatus]}</span>
      </div>
      <div class="agent-label">
        <span class="agent-icon">{COPY.symbols.agent}</span>
        <b>{state.company.agentName}</b>
        <span class="subtle">{text.agentFlow}</span>
      </div>
      <AgentResult model={model} />
      <button class="button-primary" type="submit">{text.run}</button>
      {run && <span class="timing subtle">{copyText.elapsed(run.elapsedMs)}</span>}
    </ActionForm>
    <div class="action-row">
      {
        view.canExecute && run && (
          <ActionForm action="execute" caseId={record.id}>
            <input type="hidden" name="runId" value={run.id} />
            <button class="button-primary" type="submit">
              {view.actionLabel}
            </button>
          </ActionForm>
        )
      }
      {
        view.canReconcile && operation && (
          <ActionForm action="reconcile" caseId={record.id}>
            <input type="hidden" name="operationId" value={operation.id} />
            <button class="button-secondary" type="submit">
              {text.reconcile}
            </button>
          </ActionForm>
        )
      }
    </div>
    <p class="field-note">{text.executionNote}</p>
  </div>
</section>
