---
import AppLayout from '../layouts/AppLayout.astro';
import { AUTH_COPY as text } from '../consts/copy/auth';
import { accountModel, cookieName } from '../services/account';
const token = Astro.cookies.get(cookieName())?.value ?? '';
const model = await accountModel(Astro.request, token).catch(() => null);
if (!model) return Astro.redirect('/signin');
const { account, result, error, keys, members } = model;
---

<AppLayout
  ><main class="auth-panel auth-wide">
    <h1>{text.account}</h1><a class="text-link" href="/?view=support">{text.return}</a><dl>
      <dt>{text.email}</dt><dd>{account.email}</dd><dt>{text.role}</dt><dd>
        {account.role ? text[account.role] : text.signInNeeded}
      </dd>
    </dl>{error && <p role="alert">{text.error}</p>}{
      result && (
        <section role="status">
          <>
            <p>{result.delivered ? text.delivered : text.linkReady}</p>
            <label>
              {text.link}
              <input readonly value={result.url} />
            </label>
          </>
        </section>
      )
    }{
      account.role === 'owner' && (
        <section>
          <>
            <h2>{text.invite}</h2>
            <p>{text.scope}</p>
            <form method="post" action="/account" class="auth-form">
              <>
                <label>
                  {text.inviteEmail}
                  <input type="email" name="email" required maxlength="254" autocomplete="off" />
                </label>
                <label>
                  {text.inviteRole}
                  <select name="role">
                    <>
                      <option value="agent">{text.agent}</option>
                      <option value="reviewer">{text.reviewer}</option>
                    </>
                  </select>
                </label>
                <button class="button-primary">{text.sendInvite}</button>
              </>
            </form>
          </>
        </section>
      )
    }<form method="post" action="/auth/switch" class="auth-form">
      <label
        >{text.workspace}<select name="workspaceId"
          >{
            account.memberships.map((m) => (
              <option value={m.workspaceId} selected={account.workspaceId === m.workspaceId}>
                {text.workspace} {m.workspaceId.slice(0, 8)}
              </option>
            ))
          }</select
        ></label
      ><button class="button-secondary">{text.switch}</button>
    </form>{
      account.role === 'owner' && (
        <section>
          <h2>{text.team}</h2>
          {members.map((member) => (
            <div>
              <p>
                {member.email} {text.separator} {text[member.role]}
              </p>
              {member.role !== 'owner' && (
                <form method="post" action="/account">
                  <input type="hidden" name="action" value="remove" />
                  <input type="hidden" name="userId" value={member.userId} />
                  <button class="button-secondary">{text.remove}</button>
                </form>
              )}
            </div>
          ))}
          <p>{text.keysWarning}</p>
          <form method="post" action="/account">
            <>
              <input type="hidden" name="action" value="keys" />
              <button class="button-secondary">{text.keys}</button>
            </>
          </form>
          {keys && (
            <div>
              <label>
                {text.intakeKey}
                <input readonly value={keys.intake} />
              </label>
              <label>
                {text.reviewerKey}
                <input readonly value={keys.reviewer} />
              </label>
            </div>
          )}
        </section>
      )
    }
    <form method="post" action="/auth/logout">
      <button class="button-secondary">{text.signOut}</button>
    </form>
  </main></AppLayout
>
