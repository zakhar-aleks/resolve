---
import { COPY } from '../consts/copy';
import AppLayout from '../layouts/AppLayout.astro';
import PublicHeader from '../components/PublicHeader.astro';
import PublicFooter from '../components/PublicFooter.astro';
import { customerIntake } from '../services/customer-intake';
const { reference, error } = await customerIntake(Astro.request);
const text = COPY.intake;
Astro.response.headers.set('Cache-Control', 'no-store');
---

<AppLayout
  ><div class="public-site">
    <PublicHeader /><main class="legal-main">
      <h1>{reference ? text.received : text.title}</h1><p>
        {reference ? text.receivedBody : text.description}
      </p>{
        error && (
          <p class="error-message" role="alert">
            {error}
          </p>
        )
      }{
        reference ? (
          <div class="notice">
            <>
              <p>{text.reference}</p>
              <code>{reference}</code>
            </>
          </div>
        ) : (
          <form method="post" class="customer-intake">
            <>
              <p class="inline-note">{text.demo}</p>
              <label>
                {COPY.support.customerName}
                <input name="name" required maxlength="80" />
              </label>
              <label>
                {COPY.support.requestSubject}
                <input name="title" required maxlength="120" />
              </label>
              <label>
                {COPY.support.message}
                <textarea name="message" required maxlength="4000" />
              </label>
              <label>
                {text.preference}
                <select name="aiPreference">
                  <>
                    <option value="human_only">{text.human}</option>
                    <option value="allowed">{text.allowed}</option>
                  </>
                </select>
              </label>
              <p>{text.privacy}</p>
              <a class="text-link" href="/privacy-policy">
                {COPY.product.notice}
              </a>
              <button type="submit" class="button-primary full-width">
                {text.submit}
              </button>
            </>
          </form>
        )
      }
    </main><PublicFooter />
  </div></AppLayout
>
