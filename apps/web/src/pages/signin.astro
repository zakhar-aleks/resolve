---
import AppLayout from '../layouts/AppLayout.astro';
import PublicHeader from '../components/PublicHeader.astro';
import { AUTH_COPY as text } from '../consts/copy/auth';
import { providers } from '../services/auth';
const enabled = await providers().catch(() => ({ google: false, apple: false, demo:false }));
---

<AppLayout
  ><PublicHeader /><main class="auth-panel">
    <h1>{text.title}</h1><p>{text.description}</p>{
      Astro.url.searchParams.has('error') && <p role="alert">{text.failure}</p>
    }<div class="auth-options">
      {
        (['google', 'apple'] as const).map((provider) => (
          <form method="post" action={`/auth/${provider}`}>
            <button class="button-primary" disabled={!enabled[provider]}>
              {text[provider]}
            </button>
            {!enabled[provider] && <p>{text.unavailable}</p>}
          </form>
        ))
      }
    </div><p>{text.minimal}</p><a class="text-link" href="/account-privacy">{text.notice}</a>
  </main></AppLayout
>
