---
import { DEFAULT_PRIVACY } from '@resolve/contracts';
import { COPY } from '../consts/copy';
import AppLayout from '../layouts/AppLayout.astro';
import PublicHeader from '../components/PublicHeader.astro';
import PublicFooter from '../components/PublicFooter.astro';
import { supportApi } from '../services/support-api';
import { noticeSections } from '../services/privacy-view';
let profile = DEFAULT_PRIVACY;
let companyName = COPY.productName as string;
try {
  const data = await supportApi.notice();
  profile = { ...DEFAULT_PRIVACY, ...data.profile };
  companyName = data.companyName;
} catch {
  /* The public draft remains readable if the private service is unavailable. */
}
const text = COPY.privacy;
const sections = noticeSections(profile);
Astro.response.headers.set('Cache-Control', 'no-store');
---

<AppLayout
  ><div class="public-site">
    <PublicHeader /><main class="legal-main">
      <p class="eyebrow">{text.updated}</p><h1>{text.policyTitle}</h1><p class="legal-draft">
        {text.noticeDraftBody}
      </p><section>
        <h2>{text.controller}</h2><p>{profile.legalName || companyName}</p><p>
          {profile.address || text.notProvided}
        </p>{
          profile.privacyEmail ? (
            <a class="text-link" href={`mailto:${profile.privacyEmail}`}>
              {profile.privacyEmail}
            </a>
          ) : (
            <p>{text.notProvided}</p>
          )
        }<dl class="legal-facts">
          <div><dt>{text.basis}</dt><dd>{text.bases[profile.lawfulBasis]}</dd></div><div>
            <dt>{text.hosting}</dt><dd>{profile.hostingLocation || text.notProvided}</dd>
          </div>
        </dl>
      </section>{
        sections.map((section) => (
          <section>
            <>
              <h2>{section.title}</h2>
              <p>{section.body}</p>
            </>
          </section>
        ))
      }<section>
        <h2>{text.sources}</h2><a
          class="text-link"
          href={COPY.privacyTasks.scope.link}
          target="_blank"
          rel="noreferrer">{COPY.privacyTasks.scope.title}</a
        ><a class="text-link" href={COPY.privacyTasks.rights.link} target="_blank" rel="noreferrer"
          >{COPY.privacyTasks.rights.title}</a
        >
      </section>
    </main><PublicFooter />
  </div></AppLayout
>
