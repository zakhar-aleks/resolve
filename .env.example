DATABASE_URL=postgresql://resolve:resolve@127.0.0.1:55432/resolve
API_PORT=8788
API_URL=http://127.0.0.1:8788/api
WEB_ORIGIN=http://127.0.0.1:8787
MISTRAL_MODEL=mistral-small-2603
# Optional larger model ID; used only when the company enables adaptive routing
MISTRAL_LARGE_MODEL=
MISTRAL_API_KEY=
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
STRIPE_SECRET_KEY=
STRIPE_TEST_CUSTOMER_ID=
STRIPE_TEST_PAYMENT_INTENT_ID=
# Optional Slack Socket Mode intake
SLACK_APP_TOKEN=
SLACK_TEAM_ID=
SLACK_CHANNEL_IDS=

# Agent API: generate distinct keys with npm run agent:keys
RESOLVE_API_KEY=
RESOLVE_REVIEWER_KEY=
# Optional HTTPS company service connector
SERVICE_CONNECTOR_URL=
SERVICE_CONNECTOR_TOKEN=
# Optional threaded acknowledgement for Slack mentions (chat:write)
SLACK_BOT_TOKEN=

# Required private workspace access (username: resolve); generate with npm run agent:keys
WORKSPACE_PASSWORD=
# Server-to-server only; never expose to browsers
INTERNAL_API_TOKEN=

# Required: 32-byte encryption master key (64 hex characters). Back up separately; never rotate without re-encrypting data.
DATA_ENCRYPTION_KEY=
# Public signup providers; configure exact HTTPS callback URLs in each provider console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# Optional Resend invitation delivery; links can otherwise be shared privately.
INVITE_EMAIL_API_KEY=
INVITE_EMAIL_FROM=
# Leave false on every public deployment. True enables the legacy local demo only.
ALLOW_BASIC_AUTH=false
MAX_WORKSPACES=50
# Use certificate-verified TLS when PostgreSQL is remote.
DATABASE_SSL=false
DATABASE_CA_CERT=
